# apps/gateway — Leash Gateway
#
# The ONLY service allowed to hold PayPal secrets (AGENTS.md invariant #1).
# Copy for local dev:  cp apps/gateway/.env.example apps/gateway/.env
# Never add these PayPal variables to another app's env (enforced in CI by
# `bun run check:env-isolation`).

# --- Runtime ---
# Port the gateway listens on locally. Render injects PORT in production.
PORT=8788
# development | test | production
NODE_ENV=development

# --- Neon Postgres ---
# Neon console -> project -> Connect -> "Pooled connection" (PgBouncer; driver uses prepare: false).
DATABASE_URL=

# --- PayPal ---
# sandbox | live. The hackathon uses sandbox only.
PAYPAL_ENV=sandbox
# PayPal Developer -> Apps & Credentials -> sandbox app -> Client ID.
PAYPAL_CLIENT_ID=
# PayPal Developer -> Apps & Credentials -> sandbox app -> Secret.
PAYPAL_CLIENT_SECRET=
# PayPal Developer -> the app -> Webhooks -> the webhook id used to verify signatures.
PAYPAL_WEBHOOK_ID=
# Email of the platform business sandbox account that receives and pays out funds.
PLATFORM_PAYPAL_EMAIL=

# --- Sandbox check (scripts/sandbox-check.ts) ---
# PayPal Developer -> Testing tools -> Sandbox accounts -> the personal sandbox
# account that pays invoices (the "buyer").
PAYPAL_SANDBOX_PAYER_EMAIL=
# Second personal/business sandbox account that receives payouts (the "payee").
PAYPAL_SANDBOX_PAYEE_EMAIL=

# --- Service tokens ---
# Token the web BFF uses to call the Gateway Admin API. Generate a long random string.
GATEWAY_ADMIN_TOKEN=
# Token the worker uses for internal calls. Generate a long random string.
GATEWAY_INTERNAL_TOKEN=
