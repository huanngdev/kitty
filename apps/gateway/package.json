    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kitty/eslint-config": "workspace:*",
    "@kitty/typescript-config": "workspace:*",
    "@types/bun": "1.4.3",
    "eslint": "^10.13.0",
    "typescript": "^5"
  }
}
