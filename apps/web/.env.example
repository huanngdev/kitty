# apps/web — Kitty Next.js app (UI + BFF)
#
# Copy for local dev:  cp apps/web/.env.example apps/web/.env.local
# Every app has its own .env — never put secrets in a root .env (docs/08-infrastructure.md).

# --- Server-only (never exposed to the browser) ---
# Internal URL of apps/api used by the Next rewrite proxy (/api -> apps/api).
API_URL=http://localhost:8787

# --- Client (NEXT_PUBLIC_* is inlined into the browser bundle) ---
# Public URL of this app. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PayPal JS SDK client id (public). PayPal Developer -> Apps & Credentials -> sandbox app.
# Optional until checkout is wired.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
