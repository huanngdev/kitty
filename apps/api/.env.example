# apps/api — Kitty service API (Hono on Bun)
#
# Copy for local dev:  cp apps/api/.env.example apps/api/.env
# Every app has its own .env — never put secrets in a root .env, because every
# service started from the repo root would read it (docs/08-infrastructure.md).
# Bun loads apps/api/.env automatically when you run this app.

# --- Runtime ---
# Port the API listens on locally. Render injects PORT in production.
PORT=8787
# development | test | production
NODE_ENV=development

# --- Neon Postgres ---
# Neon console -> project -> Connect -> "Pooled connection" (PgBouncer; driver uses prepare: false).
# Required by Better Auth (sessions live in the app schema).
DATABASE_URL=

# --- Auth (Better Auth) ---
# 32+ character random string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app (http://localhost:3000 in dev), because the browser
# reaches auth through the Next /api proxy. Must match the origin users visit.
BETTER_AUTH_URL=

# --- Web app origin ---
# Origin allowed to call this API from the browser.
WEB_ORIGIN=http://localhost:3000

# --- Social sign-in: GitHub (optional) ---
# Both values are required together; leave both empty to hide the button.
# Where to get them: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Application name:            Kitty (local)
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:3000/api/auth/callback/github
# Then "Generate a new client secret" and paste it below.
# Requested scopes: read:user, user:email (read-only; no repo access).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Social sign-in: PayPal "Log in with PayPal" (optional) ---
# SEPARATE REST app with ONLY the "Log in with PayPal" feature enabled — never
# the app whose secret lives in apps/gateway (AGENTS.md invariant #1, ADR-028).
# Link it to a dedicated sandbox account with zero balance. This identity only
# signs a person in; it can never move money.
# Where to get it: developer.paypal.com → Apps & Credentials → Create App (Sandbox)
#   App name:                    Kitty Login
#   Under "Other features":      check "Log in with PayPal" ONLY
#   Click "Advanced Settings":   Return URL = <your origin>/api/auth/callback/paypal
#                                select email + name permissions
#                                (PayPal sets permissions here, not via a scope param)
# Then copy the Client ID and Secret of that app.
# IMPORTANT (verified in the Better Auth + PayPal docs): PayPal rejects localhost
# return URLs. For local development expose the web app over HTTPS with a tunnel,
# e.g. `ngrok http 3100`, and use the ngrok origin for BETTER_AUTH_URL,
# WEB_ORIGIN and NEXT_PUBLIC_APP_URL (http://localhost works for email/password
# and GitHub, but not for PayPal). Live apps need PayPal's review before going live.
# PAYPAL_LOGIN_ENV: sandbox | live (default sandbox)
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
PAYPAL_LOGIN_ENV=sandbox

# --- Transactional email (optional) ---
# With both set, Kitty sends verification and password-reset emails through Resend
# and turns "email must be verified" ON in production. Leave both empty for local
# development: links are printed to this server's console instead.
# Where to get them: resend.com → API Keys → Create API Key; MAIL_FROM must be a
# verified domain or sender, e.g. "Kitty <no-reply@yourdomain.com>".
RESEND_API_KEY=
MAIL_FROM=

# Force email verification on/off (unset = on in production only when a real
# mailer is configured; off in development/test — see ADR-029).
AUTH_REQUIRE_EMAIL_VERIFICATION=

# --- Demo accounts (seed) ---
# Password for the seeded demo accounts organizer@demo.kitty and member@demo.kitty.
# Used only by `bun run seed:demo-users` (8+ characters). Pick your own local value.
DEMO_USER_PASSWORD=
# One-click demo login (POST /api/demo-sign-in). Leave "false" everywhere except
# the judge demo deployment, where the demo account is meant to be public.
DEMO_LOGIN_ENABLED=false

# --- Leash Gateway ---
# Internal URL of apps/gateway. Local: http://localhost:8788
GATEWAY_URL=
# Service token the API uses to call the Gateway Admin API. Generate a long random string.
GATEWAY_ADMIN_TOKEN=
