{
  "name": "@kitty/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test": "bun test --no-env-file --pass-with-no-tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "dependencies": {
    "@kitty/leash": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@kitty/eslint-config": "workspace:*",
    "@kitty/ledger": "workspace:*",
    "@kitty/typescript-config": "workspace:*",
    "@types/bun": "1.4.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "^5",
    "zod": "^4.6.7"
  }
}
