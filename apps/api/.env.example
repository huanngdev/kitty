# apps/api — Kitty service API (Hono on Bun)
#
# Copy for local dev:  cp apps/api/.env.example apps/api/.env
# Every app has its own .env — never put secrets in a root .env, because every
# service started from the repo root would read it (docs/08-infrastructure.md).
# Bun loads apps/api/.env automatically when you run this app.

# --- Runtime ---
# Port the API listens on locally. Render injects PORT in production.
PORT=8787
# development | test | production
NODE_ENV=development

# --- Neon Postgres ---
# Neon console -> project -> Connect -> "Pooled connection" (PgBouncer; driver uses prepare: false).
# Required by Better Auth (sessions live in the app schema).
DATABASE_URL=

# --- Auth (Better Auth) ---
# 32+ character random string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app (http://localhost:3000 in dev), because the browser
# reaches auth through the Next /api proxy. Must match the origin users visit.
BETTER_AUTH_URL=

# --- Web app origin ---
# Origin allowed to call this API from the browser.
WEB_ORIGIN=http://localhost:3000

# --- Leash Gateway ---
# Internal URL of apps/gateway. Local: http://localhost:8788
GATEWAY_URL=
# Service token the API uses to call the Gateway Admin API. Generate a long random string.
GATEWAY_ADMIN_TOKEN=
