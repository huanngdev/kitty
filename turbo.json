{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "cacheMaxSize": "10GB",
  "cacheMaxAge": "7d",
  "globalEnv": [
    "PORT",
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DEMO_USER_PASSWORD",
    "DEMO_LOGIN_ENABLED",
    "E2E_BASE_URL",
    "E2E_API_URL",
    "E2E_PAGES",
    "E2E_SESSION_COOKIE",
    "QA_PHASE",
    "QA_OUT_ROOT",
    "WEB_ORIGIN",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "PAYPAL_LOGIN_CLIENT_ID",
    "PAYPAL_LOGIN_CLIENT_SECRET",
    "PAYPAL_LOGIN_ENV",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "AUTH_REQUIRE_EMAIL_VERIFICATION",
    "GATEWAY_URL",
    "GATEWAY_ADMIN_TOKEN",
    "GATEWAY_INTERNAL_TOKEN",
    "API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_PAYPAL_CLIENT_ID",
    "PAYPAL_ENV",
    "PAYPAL_CLIENT_ID",
    "PAYPAL_CLIENT_SECRET",
    "PAYPAL_WEBHOOK_ID",
    "PLATFORM_PAYPAL_EMAIL",
    "PAYPAL_SANDBOX_PAYEE_EMAIL",
    "PAYPAL_SANDBOX_PAYER_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "test/**", "**/*.test.ts", "**/*.test.tsx"],
      "outputs": []
    }
  }
}
