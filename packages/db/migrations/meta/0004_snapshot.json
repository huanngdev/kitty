  "views": {
    "leash.account_balances": {
      "columns": {
        "kitty_id": {
          "name": "kitty_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "account": {
          "name": "account",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "balance_cents": {
          "name": "balance_cents",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      \"leash\".\"ledger_entries\".\"kitty_id\" as kitty_id,\n      \"leash\".\"ledger_entries\".\"account\" as account,\n      cast(sum(\"leash\".\"ledger_entries\".\"amount_cents\") as bigint) as balance_cents\n    from \"leash\".\"ledger_entries\"\n    group by \"leash\".\"ledger_entries\".\"kitty_id\", \"leash\".\"ledger_entries\".\"account\"\n  ",
      "name": "account_balances",
      "schema": "leash",
      "isExisting": false,
      "materialized": false
    },
    "leash.leash_balances": {
      "columns": {
        "kitty_id": {
          "name": "kitty_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "leash_id": {
          "name": "leash_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "available_cents": {
          "name": "available_cents",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "held_cents": {
          "name": "held_cents",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      \"leash\".\"ledger_entries\".\"kitty_id\" as kitty_id,\n      split_part(\"leash\".\"ledger_entries\".\"account\", ':', 2) as leash_id,\n      cast(sum(\n        case when \"leash\".\"ledger_entries\".\"account\" like 'leash:%:available' then \"leash\".\"ledger_entries\".\"amount_cents\" else 0 end\n      ) as bigint) as available_cents,\n      cast(sum(\n        case when \"leash\".\"ledger_entries\".\"account\" like 'leash:%:held' then \"leash\".\"ledger_entries\".\"amount_cents\" else 0 end\n      ) as bigint) as held_cents\n    from \"leash\".\"ledger_entries\"\n    where \"leash\".\"ledger_entries\".\"account\" like 'leash:%'\n    group by \"leash\".\"ledger_entries\".\"kitty_id\", split_part(\"leash\".\"ledger_entries\".\"account\", ':', 2)\n  ",
      "name": "leash_balances",
      "schema": "leash",
      "isExisting": false,
      "materialized": false
    }
  },
