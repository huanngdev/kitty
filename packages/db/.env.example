# packages/db — Drizzle schema + migrations (@kitty/db)
#
# Copy for local dev:  cp packages/db/.env.example packages/db/.env
# Only drizzle-kit reads this file. Applications use the pooled DATABASE_URL in
# apps/api/.env and apps/gateway/.env, never the direct URL.

# Neon console -> project -> Connect -> "Direct connection" (no `-pooler` suffix).
# Migrations must not run over the pooled connection.
DATABASE_URL_UNPOOLED=
